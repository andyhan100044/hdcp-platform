{"name": "HDCP Project Generator", "version": "1.0.0", "description": "Rapidly generate production-ready websites based on PRD using HDCP platform template", "author": "HDCP Team", "tags": ["web development", "template", "automation", "productivity", "fastapi", "nextjs", "strapi"], "category": "Development", "inputs": {"prd_path": {"type": "string", "description": "Path to Product Requirements Document (PRD)", "required": true, "example": "docs/my-prd.md"}, "scenario": {"type": "enum", "description": "Business scenario to use", "options": ["stock", "iot", "ecommerce", "carbon", "custom"], "required": true, "default": "stock"}, "features": {"type": "string", "description": "Comma-separated list of additional features", "required": false, "example": "authentication, real-time, multi-language"}, "customizations": {"type": "string", "description": "Customization requirements", "required": false, "example": "custom branding, additional APIs"}, "output_path": {"type": "string", "description": "Output directory for generated project", "required": false, "default": "generated-project"}, "template_version": {"type": "string", "description": "HDCP template version to use", "required": false, "default": "3.0.0"}}, "outputs": {"project_path": {"type": "string", "description": "Path to generated project"}, "features_enabled": {"type": "array", "description": "List of features enabled"}, "api_endpoints": {"type": "array", "description": "Generated API endpoints"}, "components": {"type": "array", "description": "Generated UI components"}, "documentation": {"type": "string", "description": "Path to generated documentation"}}, "supported_scenarios": {"stock": {"description": "Stock price monitoring and financial data", "models": ["StockPrice", "StockIndicator", "PriceAlert"], "apis": ["/api/stocks", "/api/indicators", "/api/alerts"], "components": ["StockChart", "PriceTicker", "MarketOverview"]}, "iot": {"description": "IoT sensor data and monitoring", "models": ["SensorReading", "SensorAlert", "DeviceStatus"], "apis": ["/api/sensors", "/api/readings", "/api/alerts"], "components": ["SensorMap", "LiveDashboard", "AlertList"]}, "ecommerce": {"description": "E-commerce price tracking", "models": ["ProductPrice", "PriceHistory", "ProductAlert"], "apis": ["/api/products", "/api/prices", "/api/alerts"], "components": ["ProductCard", "PriceChart", "ComparisonTable"]}, "carbon": {"description": "Carbon credit tracking and ESG data", "models": ["CarbonProject", "CarbonCredit", "ImpactMetric"], "apis": ["/api/projects", "/api/credits", "/api/impact"], "components": ["ProjectMap", "ImpactDashboard", "CreditCalculator"]}}, "automation_rules": {"model_generation": "Automatically generate SQLAlchemy models based on PRD entities", "api_generation": "Generate FastAPI endpoints with CRUD operations", "ui_generation": "Create Next.js components with Tailwind CSS", "schema_generation": "Generate Pydantic schemas for validation", "test_generation": "Create pytest test suites for all components", "documentation": "Generate API docs and deployment guides"}}