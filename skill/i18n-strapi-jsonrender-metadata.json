{"name": "HDCP i18n SEO Platform", "version": "3.0.0", "description": "Build SEO-optimized multi-language websites using Strapi + json-render with pre-generation, edge caching, and Arabic RTL support", "author": "HDCP Team", "tags": ["i18n", "internationalization", "seo", "multi-language", "arabic-rtl", "strapi", "nextjs", "json-render", "edge-cache", "ssr"], "category": "Frontend", "inputs": {"scenario": {"type": "enum", "description": "Business scenario type", "options": ["stock", "iot", "ecommerce", "carbon", "custom"], "required": true, "default": "stock"}, "languages": {"type": "string", "description": "Comma-separated list of target languages", "required": false, "default": "en,zh-CN,es,fr,de,ja,ko,ar", "example": "en,ar,zh-CN"}, "enable_arabic_rtl": {"type": "boolean", "description": "Enable Arabic RTL support with cultural compliance", "required": false, "default": true}, "enable_edge_cache": {"type": "boolean", "description": "Enable edge caching (Vercel Edge Cache or Redis)", "required": false, "default": true}, "enable_pre_generation": {"type": "boolean", "description": "Pre-generate all language versions for SEO", "required": false, "default": true}, "cdn_url": {"type": "string", "description": "CDN URL for storing generated JSON configs", "required": false, "example": "https://cdn.example.com"}, "strapi_url": {"type": "string", "description": "Strapi CMS URL", "required": false, "example": "https://cms.example.com"}, "pages": {"type": "string", "description": "Comma-separated list of pages to generate", "required": false, "default": "home,about,pricing,contact", "example": "home,about,products,blog"}, "cache_ttl": {"type": "integer", "description": "Edge cache TTL in days", "required": false, "default": 30, "example": 30}, "enable_cultural_compliance": {"type": "boolean", "description": "Enable cultural compliance checks for Arabic", "required": false, "default": true}}, "outputs": {"strapi_config": {"type": "string", "description": "Path to Strapi configuration", "example": "src/api/ui-component/content-types/ui-component/schema.json"}, "nextjs_pages": {"type": "array", "description": "Generated Next.js page files", "example": ["app/[locale]/[page]/page.tsx", "lib/i18n-client.ts"]}, "component_registry": {"type": "string", "description": "Path to component registry with RTL support", "example": "components/registry.tsx"}, "cache_config": {"type": "string", "description": "Edge cache configuration", "example": "app/api/revalidate/route.ts"}, "css_rtl": {"type": "string", "description": "RTL-specific CSS rules", "example": "styles/rtl.css"}, "seo_config": {"type": "object", "description": "SEO configuration with hreflang", "example": {"hreflang": true, "structuredData": true, "canonical": true}}, "cultural_compliance": {"type": "object", "description": "Cultural compliance rules for Arabic", "example": {"prohibited": ["alcohol", "pork", "rainbow"], "numberFormat": "0123456789", "dateFormat": "dd/mm/yyyy"}}, "deployment_guide": {"type": "string", "description": "Path to deployment guide", "example": "docs/deployment.md"}}, "supported_languages": {"en": {"name": "English", "nativeName": "English", "flag": "🇺🇸", "rtl": false, "direction": "ltr", "fontFamily": "Inter, system-ui, sans-serif", "dateFormat": "mm/dd/yyyy"}, "zh-CN": {"name": "Chinese Simplified", "nativeName": "简体中文", "flag": "🇨🇳", "rtl": false, "direction": "ltr", "fontFamily": "PingFang SC, system-ui, sans-serif", "dateFormat": "yyyy年mm月dd日"}, "es": {"name": "Spanish", "nativeName": "Español", "flag": "🇪🇸", "rtl": false, "direction": "ltr", "fontFamily": "Inter, system-ui, sans-serif", "dateFormat": "dd/mm/yyyy"}, "fr": {"name": "French", "nativeName": "Français", "flag": "🇫🇷", "rtl": false, "direction": "ltr", "fontFamily": "Inter, system-ui, sans-serif", "dateFormat": "dd/mm/yyyy"}, "de": {"name": "German", "nativeName": "Deutsch", "flag": "🇩🇪", "rtl": false, "direction": "ltr", "fontFamily": "Inter, system-ui, sans-serif", "dateFormat": "dd.mm.yyyy"}, "ja": {"name": "Japanese", "nativeName": "日本語", "flag": "🇯🇵", "rtl": false, "direction": "ltr", "fontFamily": "Hiragino Kaku Gothic Pro, system-ui, sans-serif", "dateFormat": "yyyy年mm月dd日"}, "ko": {"name": "Korean", "nativeName": "한국어", "flag": "🇰🇷", "rtl": false, "direction": "ltr", "fontFamily": "Apple SD Gothic Neo, system-ui, sans-serif", "dateFormat": "yyyy-mm-dd"}, "ar": {"name": "Arabic", "nativeName": "العربية", "flag": "🇸🇦", "rtl": true, "direction": "rtl", "fontFamily": "Cairo, Tajawal, sans-serif", "dateFormat": "dd/mm/yyyy", "special_features": ["rtl-support", "cultural-filtering", "number-format", "date-format", "hyphens", "font-optimization"]}}, "architecture_components": {"strapi": {"role": "Component metadata CMS", "features": ["ui-components", "rtl-components", "i18n-keys", "compliance-tags"]}, "nextjs": {"role": "Frontend framework", "features": ["app-router", "ssr", "static-generation", "edge-runtime"]}, "json_render": {"role": "Runtime renderer", "features": ["dynamic-rendering", "component-registry", "server-side-rendering"]}, "edge_cache": {"role": "Performance optimization", "features": ["cdn", "30-day-ttl", "automatic-purge"]}, "ai_generation": {"role": "Content generation", "features": ["build-time-only", "gpt-4", "cultural-context"]}}, "seo_features": {"hreflang": {"description": "Automatic hreflang tags for all languages", "implementation": "generateStaticParams + alternate links"}, "structured_data": {"description": "JSON-LD structured data for rich snippets", "implementation": "meta.structuredData in generated JSON"}, "canonical_urls": {"description": "Canonical URLs for duplicate content prevention", "implementation": "Next.js metadata API"}, "sitemaps": {"description": "Multi-language sitemaps", "implementation": "auto-generated per language"}, "core_web_vitals": {"description": "Optimized for Google's Core Web Vitals", "implementation": "SSR + Edge Cache + Pre-generation"}}, "arabic_rtl_features": {"direction": {"description": "Right-to-left text direction", "css": "dir=\"rtl\"", "required": true}, "font_optimization": {"description": "Arabic-optimized fonts", "fonts": "Cairo, Tajawal", "required": true}, "hyphens": {"description": "Automatic hyphenation for better wrapping", "css": "hyphens: auto", "required": true}, "icon_mirroring": {"description": "Mirror icons for RTL context", "implementation": "CSS transform: scaleX(-1)", "examples": ["arrow", "back-button", "forward-button"]}, "cultural_filtering": {"description": "Filter culturally sensitive content", "prohibited": ["alcohol", "pork", "rainbow", "lgbt"], "implementation": "LLM content detection"}, "number_format": {"description": "Use Arabic numerals (0123456789) not Arabic-Indic numerals", "required": true}, "date_format": {"description": "Use DD/MM/YYYY format", "required": true}, "button_height": {"description": "Increase button height by 30% for longer Arabic text", "implementation": "CSS min-height adjustment"}, "margin_padding": {"description": "Use logical properties (margin-inline-start)", "implementation": "CSS logical properties instead of directional"}}, "performance_metrics": {"before_optimization": {"bounce_rate": ">70%", "seo_traffic": "<10%", "mobile_experience": "horizontal-scroll", "conversion_rate": "baseline", "click_through_rate": "baseline"}, "after_optimization": {"bounce_rate": "<45%", "seo_traffic": "35-40%", "mobile_experience": "perfect-fit", "conversion_rate": "+18%", "click_through_rate": "+22%"}}, "golden_rules": ["Never call AI generation in production (SEO disaster)", "Always use generateStaticParams for pre-generation", "Use edge caching (Vercel Edge Cache or Redis)", "Always render HTML on server (Next.js App Router)", "Load i18n文案 dynamically, use AI for static structure only", "Enable RTL support for Arabic (dir=\"rtl\")", "Use logical CSS properties (margin-inline-start)", "Implement cultural compliance checks for Arabic", "Pre-generate all language versions", "Use 30+ day cache TTL for SEO content", "Include hreflang tags for all languages", "Generate structured data (JSON-LD) for SEO"], "checklist": {"pre_generation": ["All pages use generateStaticParams", "No runtime AI generation", "Static params generated for all languages"], "i18n": ["Translation keys use labelKey not hardcoded", "Each <html> tag has correct lang attribute", "Complete hreflang link group in page head"], "seo": ["hreflang tags cover all languages", "Keywords localized (not literal translation)", "URL uses subdirectory structure /ar/ not query params", "robots.txt and sitemap.xml include multi-language versions"], "rtl_arabic": ["Arabic pages use dir=\"rtl\" and lang=\"ar\"", "CSS uses logical properties", "Navigation, tables, charts right-aligned", "Arabic hyphenation enabled (hyphens:auto)", "Icons have RTL mirror versions", "Button height increased by 30%", "Arabic numerals (0-9) not Arabic-Indic (٠١٢)", "Date format DD/MM/YYYY"], "performance": ["Arabic font loading optimized (Cairo, Tajawal)", "Icon mirroring uses CSS not multiple images", "No horizontal scroll on mobile", "Page bounce rate < 45%"], "cultural_compliance": ["Arabic hides alcohol/pork/rainbow elements", "Arabic content manually translated (no machine translation)", "No religious sensitive words", "DMCA 2024 compliance check passed"]}, "common_pitfalls": {"fatal": ["Using LTR layout for Arabic (70% bounce rate)", "No hyphenation causes horizontal scroll (+30% bounce)", "Icons not mirrored (back becomes forward)", "Literal keyword translation (zero Arabic SEO traffic)", "Arabic contains alcohol/pork/rainbow (legal risk)", "Using Arabic-Indic numerals (0-0123456789)", "Arabic text length not adapted (truncated buttons)", "Machine translation without review (DMCA fine)", "Missing hreflang (Google treats as duplicate content)", "Arabic URL uses ?lang=ar (hreflang not recognized)"], "severe": ["Using useEffect for AI generation", "Exposing AI API keys to browser", "Dynamic routes without pre-generation", "Translation text in AI-generated JSON", "Ignoring robots.txt and sitemap.xml"]}, "automation_flow": {"trigger": "User says 'implement multi-language website' or 'Arabic website'", "steps": ["Identify trigger keywords", "Load this skill", "Scan existing code for Strapi/Next.js structure", "Generate scaffolding (Step 1-5)", "Auto-configure environment variables, webhooks, CDN paths", "Output verification commands"], "result": "npm run dev works with all pages pre-generated, SEO perfect, AI cost near zero"}, "examples": {"basic_english": {"description": "English-only website", "languages": ["en"], "arabic_rtl": false}, "multi_language": {"description": "7-language website without Arabic", "languages": ["en", "zh-CN", "es", "fr", "de", "ja", "ko"], "arabic_rtl": false}, "with_arabic": {"description": "8-language website with Arabic RTL", "languages": ["en", "zh-CN", "es", "fr", "de", "ja", "ko", "ar"], "arabic_rtl": true}, "ecommerce": {"description": "E-commerce with Arabic support", "scenario": "ecommerce", "languages": ["en", "ar"], "arabic_rtl": true, "cultural_compliance": true}}, "deployment_commands": {"build": "npm run generate:i18n && npm run build", "dev": "npm run dev", "test": "npm run test", "verify_seo": "npm run lighthouse", "check_rtl": "npm run test:rtl"}}